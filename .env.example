# --- AI (agy CLI — Gemini 4 Neon, Medium reasoning effort) ---
AGY_MODEL=gemini-4-neon-medium
AGY_REASONING_EFFORT=medium
AGY_TIMEOUT_SECONDS=300
AGY_MAX_RETRIES=2

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discovery & Matching ---
SCRAPE_INTERVAL_MINUTES=30
JOB_MAX_AGE_DAYS=14
JOB_MATCH_THRESHOLD=75
MAX_ANALYSES_PER_RUN=8
DEFAULT_LANGUAGE=pt

# --- Automated Applications ---
AUTO_APPLY_ENABLED=true
# Keep true while testing: runs analysis, resume/cover-letter PDF generation,
# and form filling WITHOUT clicking Submit. Set to false for live submissions.
APPLICATION_DRY_RUN=true
MAX_APPLICATIONS_PER_RUN=5
MAX_APPLICATIONS_PER_DAY=20
APPLICATION_INTERVAL_SECONDS=30
APPLICATION_MAX_RETRIES=3
APPLICATION_RETRY_BACKOFF_MINUTES=30
APPLICATION_TIMEOUT_SECONDS=60

# --- Paths ---
RESUMES_DIR=resumes
APPLICATIONS_DIR=data/applications
DATABASE_PATH=data/jobs.db
PROFILE_JSON_PATH=state/profile.json
PROFILE_MD_PATH=state/profile.md
LOCK_FILE=state/jobbot.lock

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Scrapers ---
MAX_PAGES_PER_PORTAL=2
LINKEDIN_ENABLED=true
PROGRAMATHOR_ENABLED=true
GEEKHUNTER_ENABLED=true
QUEROVAGAS_ENABLED=true
DEVAGAS_ENABLED=true
NERDIN_ENABLED=true
QUEROVAGAS_WORK_MODE=Remote
LINKEDIN_KEYWORDS=desenvolvedor
LINKEDIN_SEARCH_TERMS=desenvolvedor python node

# --- Pre-AI filters (comma separated, case insensitive) ---
BLOCKED_TITLE_KEYWORDS=
BLOCKED_COMPANIES=
